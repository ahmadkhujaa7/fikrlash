APP_NAME=Fikrlash.uz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tashkent

APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database (MySQL 8+). Lokal sinov uchun DB_CONNECTION=sqlite ham ishlaydi. ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fikrlash
DB_USERNAME=root
DB_PASSWORD=

# ---- Session / Cache / Queue ----
# Lokal: database (Redis shart emas). Production: redis.
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Fayllar: public (lokal) yoki s3 (production, S3-compatible) ----
FILESYSTEM_DISK=local
MEDIA_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---- Mail (hozircha ishlatilmaydi) ----
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@fikrlash.uz"
MAIL_FROM_NAME="${APP_NAME}"

# ---- SMS: log (development — kod storage/logs/laravel.log da), eskiz (production) ----
SMS_DRIVER=log
SMS_SENDER=4546
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# SMS_OTP_TEMPLATE="Fikrlash.uz tasdiqlash kodi: :code"

# ---- AI: fake (kalitsiz), claude, openai, null (o‘chiq) ----
AI_ENABLED=true
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
AI_CLAUDE_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
AI_REQUESTS_PER_MINUTE=30
AI_DAILY_LIMIT=5000

# ---- Platforma ----
# Ko‘rishlarni Redis'da yig‘ish (production + Redis bo‘lsa "redis").
VIEWS_BUFFER=direct
SECURITY_CSP=true
SECURITY_HSTS=false
# Nginx/load balancer IP manzillari (vergul bilan)
TRUSTED_PROXIES=127.0.0.1

# Seeder admin yaratadi (bo‘sh bo‘lsa lokal: +998900000001 / admin12345)
ADMIN_PHONE=
ADMIN_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

VITE_APP_NAME="${APP_NAME}"
